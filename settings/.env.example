# ============================================================
# Backend Server
# ============================================================
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=5003
RELOAD=false

# ============================================================
# Frontend Server
# ============================================================
UI_HOST=127.0.0.1
UI_PORT=8003
UI_API_BASE_URL=/api

# Optional cross-origin access. Leave origins empty to disable CORS.
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_CREDENTIALS=false
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Authorization,Content-Type,X-XREPORT-Desktop-Token

# Optional resource root override. Relative paths are resolved from the
# repository root; the default is data.
XREPORT_RESOURCES_DIR=

# ============================================================
# ML Runtime
# ============================================================
MPLBACKEND=Agg
KERAS_BACKEND=torch
INFERENCE_HF_LOCAL_ONLY=true
INFERENCE_DEVICE=auto

# Optional: required only for gated public models after accepting their Hub terms.
# Never commit a real token or expose it through the browser.
HF_TOKEN=
