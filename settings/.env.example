# ============================================================
# Backend Server
# ============================================================
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=5003
RELOAD=false
# Set to true to open a terminal window showing backend logs.
BACKEND_VISIBLE=true

# ============================================================
# Frontend Server
# ============================================================
UI_HOST=127.0.0.1
UI_PORT=8003
UI_API_BASE_URL=/api
ALWAYS_REBUILD=false

# Optional resource root override. Relative paths are resolved from the
# repository root; the default is app/resources. The embedded SQLite database
# is stored as database.db beneath this directory.
XREPORT_RESOURCES_DIR=

# ============================================================
# Database Mode
# ============================================================
# true  = use the embedded SQLite database
# false = use the external PostgreSQL connection below
EMBEDDED_DATABASE=true

# ============================================================
# External Database Connection
# ============================================================
# When provided, DATABASE_URL seeds the host, port, database name, username,
# and password. Explicit DATABASE_* values below override URL parts.
DATABASE_URL=
DATABASE_ENGINE=postgresql+psycopg
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=XREPORT
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=

# ============================================================
# External Database Security And Performance
# ============================================================
DATABASE_SSL=false
DATABASE_SSL_CA=
DATABASE_CONNECT_TIMEOUT=30
DATABASE_INSERT_BATCH_SIZE=1000

# ============================================================
# ML Runtime
# ============================================================
MPLBACKEND=Agg
KERAS_BACKEND=torch

# ============================================================
# Embedded Hugging Face Inference
# ============================================================
HF_LOCAL_ONLY=true
# Optional: required only for gated public models after accepting their Hub terms.
# Never commit a real token or expose it through the browser.
HF_TOKEN=
INFERENCE_DEVICE=auto
INFERENCE_MAX_LOADED_MODELS=1
INFERENCE_MODEL_TIMEOUT=600
