{
  "name": "xreport-client",
  "version": "3.3.1",
  "scripts": {
    "generate:api": "openapi-ts",
    "ng": "ng",
    "start": "ng serve client-angular --proxy-config src/proxy.conf.cjs",
    "dev": "ng serve client-angular --proxy-config src/proxy.conf.cjs",
    "start:studio": "ng serve studio-angular --proxy-config src/proxy.studio.conf.cjs",
    "build": "ng build client-angular",
    "build:studio": "ng build studio-angular",
    "watch": "ng build client-angular --watch --configuration development",
    "preview": "node scripts/serve-built.cjs",
    "test": "ng test client-angular --watch=false",
    "test:unit": "ng test client-angular --watch=false",
    "test:built-server": "node --test scripts/serve-built.test.cjs",
    "test:e2e": "set \"STANDARD_TEST_PYTEST_TARGET=..\\tests\\e2e\\test_angular_ui.py\" && set \"STANDARD_TEST_SKIP_CLIENT_TESTS=true\" && ..\\tests\\run_tests.bat",
    "lint": "ng lint client-angular"
  },
  "private": true,
  "packageManager": "npm@10.9.8",
  "dependencies": {
    "@angular/cdk": "22.1.8",
    "@angular/common": "22.1.8",
    "@angular/compiler": "22.1.8",
    "@angular/core": "22.1.8",
    "@angular/forms": "22.1.8",
    "@angular/platform-browser": "22.1.8",
    "@angular/router": "22.1.8",
    "@ng-icons/core": "^35.0.1",
    "@ng-icons/lucide": "^35.0.1",
    "@tauri-apps/api": "2.8.0",
    "@tauri-apps/plugin-dialog": "2.4.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "22.1.8",
    "@angular/cli": "22.1.8",
    "@angular/compiler-cli": "22.1.8",
    "@eslint/js": "^10.0.1",
    "angular-eslint": "22.1.0",
    "eslint": "^10.6.0",
    "jsdom": "^28.0.0",
    "@hey-api/openapi-ts": "0.99.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.62.1",
    "vitest": "4.1.11"
  }
}
